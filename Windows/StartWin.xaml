<Window x:Name="pongWin" x:Class="PongGame.Windows.StartWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pong" Height="503" Width="824" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/moritz-mentges-2RLRbRkWtpc-unsplash.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <!-- ................................................................................................................................................ -->
    <Window.Resources>
        <ControlTemplate x:Key="btns" TargetType="Button">
            <Grid>
                <Button  Name="startbtn" Background="Transparent" IsEnabled="true" 
                         FontFamily="Square721 BT" FontSize="50"  Foreground="#FFD56DE0" Content="{TemplateBinding Content}"
                         FontWeight="Normal" FontStretch="Normal" BorderBrush="{x:Null}" Height="65" Width="192">
                </Button>
                <!--Needs the <Border></Border> to change background color as well wtf-->
                <Border x:Name="border" Background="Transparent" /> 
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger  Property="IsMouseOver" Value="True">
                    <Setter TargetName="startbtn" Property="Foreground" Value="#FCD1FB" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>
    <!-- ................................................................................................................................................ -->
    <Canvas Name="mainCanvas" Width="800" Height="475">
        <Button Template="{StaticResource btns}"  Content="Start"
            x:Name="btnStart" Canvas.Left="305" Canvas.Top="98" Click="btnStart_Click" >
        </Button>

        <Button Template="{StaticResource btns }" Content="Options"
            x:Name="btnOptions" Canvas.Left="307" Canvas.Top="163" Click="btnOptions_Click"/>

        <Button Template="{StaticResource btns }" Content="Exit"
            x:Name="btnExit" Canvas.Left="307" Background="Transparent" Canvas.Top="228" Click="btnExit_Click" />
    </Canvas>


</Window>