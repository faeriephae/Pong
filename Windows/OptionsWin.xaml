<Window x:Name="pongWin" x:Class="PongGame.Windows.OptionsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:r="clr-namespace:PongGame.Resources"
        Title="Pong" Height="503" Width="824" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/moritz-mentges-2RLRbRkWtpc-unsplash.jpg" Opacity="0.5" Stretch="UniformToFill">
            <ImageBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                    <RotateTransform CenterY="0.5" CenterX="0.5"/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </ImageBrush.RelativeTransform>
        </ImageBrush>
    </Window.Background>

    <!-- ................................................................................................................................................ -->
    <Window.Resources>
        <ControlTemplate x:Key="options" TargetType="Label">
            <Grid>
                <Label  Name="op" Background="Transparent" IsEnabled="true" HorizontalAlignment="Left"
                         FontFamily="Square721 BT" FontSize="35"  Foreground="#FFD56DE0" Content="{TemplateBinding Content}"
                         FontWeight="Normal" FontStretch="Normal" Height="65" Width="192" Margin="{TemplateBinding Margin}" >
                </Label>
                <!--Needs the <Border></Border> to change background color as well wtf-->
                <Border x:Name="border" Background="Transparent" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger  Property="IsMouseOver" Value="True">
                    <Setter TargetName="op" Property="Foreground" Value="#FCD1FB" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>
    <!-- ................................................................................................................................................ -->
    <Canvas Name="mainCanvas" Width="800" Height="475">
        <Label Template="{StaticResource options}"  Content="Sound"
            x:Name="op1" Canvas.Left="29" Canvas.Top="40"  >
        </Label>

        <Label Template="{StaticResource options }" Content="Appearance"
            x:Name="bop2" Canvas.Left="29" Canvas.Top="90"/>

        <Label Template="{StaticResource options }" Content="Sth else I'll think of later"
            x:Name="op3" Canvas.Left="29" Background="Transparent" Canvas.Top="140"  />
    </Canvas>


</Window>