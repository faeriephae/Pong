<Window x:Name="pongWin" x:Class="PongGame.Windows.GameWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        KeyDown="SecondControlsDown"
        mc:Ignorable="d"
        Title="Pong" Height="503" Width="824" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#FF191919" ResizeMode="NoResize" SizeToContent="WidthAndHeight" SnapsToDevicePixels="True">

    <Canvas Name="mainCanvas" Width="800" Height="475" Background="#FF191919">

        <Rectangle Name="rectP1" Height="130" Width="20" Fill="#FF636363"
                   Canvas.Top="{Binding YPosition}"
                    RadiusX="10" RadiusY="10">
        </Rectangle>
        <Rectangle Name="rectP2"  Height="130" Width="20" Fill="#FF636363"
                   Canvas.Top="{Binding YPosition}"
                   Canvas.Left="780"
                   RadiusX="10" RadiusY="10">
        </Rectangle>
        <Line x:Name="line" X1="400" X2="400" Y2="500" Y1="0" StrokeThickness="2" Stroke="#FFD56DE0" Height="450" Canvas.Top="12"></Line>
        <Ellipse Width="25" Height="25" Canvas.Left="{Binding X}"
                 Canvas.Top="{Binding Y}" Name="ball" DataContext="{Binding Path=ball}" StrokeThickness="0.1" Fill="#FF7DDCE0">
        </Ellipse>
    </Canvas>
</Window>