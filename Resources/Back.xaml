<UserControl x:Name="Return" x:Class="PongGame.Resources.Back"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PongGame.Resources"
             mc:Ignorable="d" Height="88" Width="93">
    <Grid x:Name="returnGrid">
        <Button x:Name="btnReturn" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Height="86" Width="91" BorderBrush="{x:Null}" Foreground="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="/Resources/return.png" Stretch="UniformToFill"/>
            </Button.Background>
        </Button>

    </Grid>
</UserControl>
